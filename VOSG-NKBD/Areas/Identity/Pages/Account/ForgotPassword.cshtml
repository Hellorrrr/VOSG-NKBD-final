@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_Layout";
}

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="text-center mb-4">
            <div style="font-size:2.5rem;">🔑</div>
            <h1>Forgot Password?</h1>
            <p>Enter your email and we'll send you a reset link</p>
        </div>
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label">Email Address</label>
                <input asp-for="Input.Email" class="form-control" placeholder="your@email.com" autocomplete="username" />
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>
            <button type="submit" class="w-100 btn btn-primary btn-lg">
                <i class="bi bi-envelope me-1"></i>Send Reset Link
            </button>
        </form>
        <hr class="my-3" />
        <p class="text-center text-muted small mb-0">
            Remember your password?
            <a asp-page="./Login" class="fw-semibold">Login here</a>
        </p>
        <p class="text-center text-muted small mb-0 mt-1">
            Don't have an account?
            <a asp-page="./Register" class="fw-semibold">Register here</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
