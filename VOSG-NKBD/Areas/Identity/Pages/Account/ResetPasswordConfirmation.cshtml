@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Password Reset Successful";
    Layout = "_Layout";
}

<div class="auth-wrapper">
    <div class="auth-card text-center">
        <div style="font-size:3rem;">✅</div>
        <h1 class="mt-2">Password Reset!</h1>
        <p class="text-muted">Your password has been successfully reset. You can now login with your new password.</p>
        <a asp-page="./Login" class="w-100 btn btn-primary btn-lg mt-3">
            <i class="bi bi-box-arrow-in-right me-1"></i>Login Now
        </a>
        <hr class="my-3" />
        <p class="text-muted small mb-0">
            Don't have an account?
            <a asp-page="./Register" class="fw-semibold">Register here</a>
        </p>
    </div>
</div>
