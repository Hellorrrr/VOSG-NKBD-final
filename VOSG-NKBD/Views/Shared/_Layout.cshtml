<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VOSG_NKBD</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/VOSG_NKBD.styles.css" asp-append-version="true" />
    <style>
        .nav-right {
        display: flex;
        align-items: center;
        gap: 36px;
        }

        .nav-right a {
        font-size: 15px;
        text-decoration: none;
        color: #333;
        }

        .btn-login {
        background: #1a3a6b;
        color: white !important;
        border-radius: 6px;
        padding: 6px 22px;
        font-size: 15px;
        }

        .btn-login:hover {
        background: #142d55;
        color: white !important;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-transparent border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand p-0 d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo-vosg.png" alt="VOSG-NKBD" height="70" style="object-fit:contain;" />
                    <div style="line-height:1.5; text-align:center; width:100%;">
                        <div style="font-size:14px; font-weight:700; color:#20c997; letter-spacing:0.3px; text-align:center;">Vietnamese Overseas Students Group</div>
                        <div style="font-size:12px; font-weight:600; color:#20c997; letter-spacing:0.5px; text-align:center;">--- Nguyen Khuyen Binh Duong ---</div>
                    </div>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-end align-items-center">
                    <div class="nav-right">
                        <a asp-area="" asp-controller="Home" asp-action="Index">Home</a>

                        <a asp-area="" asp-controller="Locations" asp-action="Index">Venues</a>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a asp-area="" asp-controller="Confirmations" asp-action="Index">My Bookings</a>
                        }

                        <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>

    
    <main role="main" class="pb-3">
        @RenderBody()
    </main>

    
    <footer class="border-top footer text-muted">
        <div class="container">
            <span style="color:#ffc107; font-weight:700;">&copy; 2026 - VOSG-NKBD</span> - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    
    @if (TempData["Success"] != null)
    {
        <div id="successToast" style="position:fixed;bottom:2rem;right:2rem;z-index:9999;
            background:#22543D;color:#fff;border-radius:10px;padding:1rem 1.5rem;
            box-shadow:0 4px 20px rgba(0,0,0,0.2);display:flex;align-items:center;gap:0.75rem;
            animation:slideIn 0.4s ease;">
            <i class="bi bi-check-circle-fill" style="font-size:1.3rem;"></i>
            <span>@TempData["Success"]</span>
        </div>
        <style>
            @@keyframes slideIn {
            from {
            opacity: 0;
            transform: translateY(20px);
            }

            to {
            opacity: 1;
            transform: translateY(0);
            }
            }
        </style>
        <script>
            setTimeout(function() {
            var t = document.getElementById('successToast');
            if (t) { t.style.transition='opacity 0.4s'; t.style.opacity='0'; setTimeout(function(){t.remove();},400); }
            }, 3500);
        </script>
    }

</body>
</html>