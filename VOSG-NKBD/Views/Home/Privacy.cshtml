@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container py-4" style="max-width:760px;">
    <div class="vosg-card">
        <h1 class="section-title mb-4">🔒 Privacy <span>Policy</span></h1>
        <p class="text-muted">Last updated: 2026</p>

        <h5 class="fw-bold mt-4">What we collect</h5>
        <p>
            When you create an account we store your name, email and the password you set (hashed, we never see or store the plain text).
            When you book a space, we store the booking time, the space you booked, and a payment record tied to your account.
        </p>

        <h5 class="fw-bold mt-4">What we use it for</h5>
        <p>
            Your account info is used to log you in and show you your own bookings. Admins can see booking details
            for all members so they can manage venues, but they cannot see your password.
        </p>

        <h5 class="fw-bold mt-4">What we don't do</h5>
        <p>
            We don't sell or share your information with third parties. We don't send marketing emails - the only
            emails you'll get are account-related (password reset, email confirmation).
        </p>

        <h5 class="fw-bold mt-4">Your data</h5>
        <p>
            You can ask us to delete your account and personal data at any time by contacting an admin.
        </p>

        <p class="text-muted mt-4 mb-0">
            This is a student project (Vietnamese Overseas Students Group - Nguyen Khuyen Binh Duong) built for
            coursework, not a commercial service.
        </p>
    </div>
</div>
