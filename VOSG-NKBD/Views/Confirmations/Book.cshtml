@* details page for ONE location: photo + info table,
   the bookable spaces underneath, and admin buttons at the bottom *@
@model VOSG_NKBD.Models.Confirmation
@{
    ViewData["Title"] = "Book " + Model.Place?.PlaceName;
}

<div class="container py-4">
    <div class="row g-4 justify-content-center">
        <div class="col-lg-7">
            <div class="vosg-card">
                <h2 class="section-title mb-4">🗓️ Book <span>@Model.Place?.PlaceName</span></h2>
                <p class="text-muted mb-4">Choose your start and end time for this space.</p>

                <div asp-validation-summary="All" class="alert alert-danger"
                     style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

                <form asp-action="Book" method="post">
                    @* using plain name= instead of asp-for here on purpose - asp-for kept
                       rendering the datetime in a format the datetime-local input didnt like,
                       easier to just control the string myself *@
                    <input type="hidden" name="PlaceID" value="@Model.PlaceID" />
                    <input type="hidden" name="TotalPrice" value="@Model.TotalPrice" />

                    <div class="row g-3 mb-4">
                        <div class="col-sm-6">
                            <label class="form-label">Start Time</label>
                            <input type="datetime-local" name="StartTime" class="form-control"
                                   value="@Model.StartTime.ToString("yyyy-MM-ddTHH:mm")" required />
                            <span asp-validation-for="StartTime" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label">End Time</label>
                            <input type="datetime-local" name="EndTime" class="form-control"
                                   value="@Model.EndTime.ToString("yyyy-MM-ddTHH:mm")" required />
                            <span asp-validation-for="EndTime" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary flex-fill">
                            <i class="bi bi-arrow-right-circle me-1"></i>Continue to Confirm
                        </button>
                        <a asp-controller="Locations" asp-action="Details"
                           asp-route-id="@Model.Place?.LocationsID" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i>Back
                        </a>
                    </div>
                </form>
            </div>
        </div>

        @* same summary card style as Confirm.cshtml so the two pages dont look disconnected *@
        <div class="col-lg-4">
            <div class="booking-summary">
                @if (!string.IsNullOrEmpty(Model.Place?.ImageUrl))
                {
                    <img src="@Model.Place.ImageUrl" alt="@Model.Place.PlaceName"
                         style="width:100%;height:160px;object-fit:cover;border-radius:8px;margin-bottom:1rem;" />
                }
                else
                {
                    <div style="background:linear-gradient(135deg,var(--primary),var(--accent));height:160px;border-radius:8px;display:flex;align-items:center;justify-content:center;margin-bottom:1rem;">
                        <i class="bi bi-building text-white" style="font-size:3rem;"></i>
                    </div>
                }
                <h5 class="fw-bold mb-3">Booking Summary</h5>
                <div class="summary-row"><span>Location</span><strong>@Model.Place?.Location?.LocationName</strong></div>
                <div class="summary-row"><span>Section</span><strong>@Model.Place?.PlaceName</strong></div>
                <div class="summary-row summary-total"><span>Price</span><strong>$@Model.Place?.Price.ToString("N2") NZD</strong></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}